# DeskTicket local/demo configuration
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local default. Render/Neon should provide a PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///db.sqlite3

# Redis is only required when running Celery workers/beat.
REDIS_URL=redis://127.0.0.1:6379/0

APP_NAME=DeskTicket
APP_URL=http://127.0.0.1:8000

# Demo mode disables real mailbox polling and outbound email.
DEMO_MODE=False
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo@12345

# Required for encrypting saved mailbox secrets when mailbox features are used.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_ENCRYPTION_KEY=

DEFAULT_FROM_EMAIL=support@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_POLL_INTERVAL_SECONDS=60
